{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuhonas/free-exercise-db/schema/exercise.schema.json",
  "title": "Exercise",
  "description": "One record in dist/exercises.json. Null means the field was not recorded, not that it does not apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "force", "level", "mechanic", "equipment", "primaryMuscles", "secondaryMuscles", "instructions", "category", "images"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_()'.,&-]+$", "description": "Also the directory name under exercises/." },
    "name": { "type": "string", "minLength": 1 },
    "force": { "enum": ["push", "pull", "static", null] },
    "level": { "enum": ["beginner", "intermediate", "expert"] },
    "mechanic": { "enum": ["compound", "isolation", null] },
    "equipment": {
      "enum": ["bands", "barbell", "body only", "cable", "dumbbell", "e-z curl bar", "exercise ball", "foam roll", "kettlebells", "machine", "medicine ball", "other", null]
    },
    "primaryMuscles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/muscle" } },
    "secondaryMuscles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/muscle" } },
    "instructions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "category": { "enum": ["cardio", "olympic weightlifting", "plyometrics", "powerlifting", "strength", "stretching", "strongman"] },
    "images": { "type": "array", "items": { "type": "string", "pattern": "^[^/]+/[0-9]+\\.jpg$" } }
  },
  "$defs": {
    "muscle": {
      "enum": ["abdominals", "abductors", "adductors", "biceps", "calves", "chest", "forearms", "glutes", "hamstrings", "lats", "lower back", "middle back", "neck", "quadriceps", "shoulders", "traps", "triceps"]
    }
  }
}
