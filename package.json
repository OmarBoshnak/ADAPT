{
  "name": "adapt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ADAPT — an adaptive fitness product for Amazon Fire TV. Your workout reacts to you.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/relay",
    "tools/build-graph",
    "tools/sim",
    "tools/fake-sensor",
    "tools/console-tv",
    "tools/tune",
    "tools/contract",
    "oss/free-exercise-db-graph"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json && tsc -p oss/free-exercise-db-graph --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "tsc --build && node tools/build-graph/dist/cli.js",
    "sim": "tsc --build && node tools/sim/dist/cli.js",
    "relay": "tsc --build && node apps/relay/dist/main.js",
    "fake-sensor": "tsc --build && node tools/fake-sensor/dist/cli.js",
    "audit:copy": "bash scripts/audit-copy.sh",
    "verify": "npm run typecheck && npm run tv:typecheck && npm run phone:typecheck && npm run lint && npm test && npm run tv:test && npm run phone:test && npm run coach:test && npm run audit:copy",
    "console-tv": "tsc --build && node tools/console-tv/dist/cli.js",
    "tv:typecheck": "tsc -p apps/tv --noEmit",
    "tv:test": "npm --prefix apps/tv test",
    "tv:build": "tsc --build && npm --prefix apps/tv run build:release",
    "phone:typecheck": "tsc --build && npm --prefix apps/phone run typecheck",
    "phone:ios": "tsc --build && npm --prefix apps/phone run ios:device",
    "phone:test": "npm --prefix apps/phone test",
    "tune": "tsc --build && node tools/tune/dist/cli.js",
    "relay:record": "tsc --build && node apps/relay/dist/main.js --record",
    "contract": "tsc --build && node tools/contract/dist/cli.js",
    "coach:test": "cd services/coach && uv run --group dev pytest -q",
    "coach:dev": "cd services/coach && uv run python main.py",
    "oss:build": "npm --workspace free-exercise-db-graph run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
