{
  "name": "adapt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ADAPT — an adaptive fitness product for Amazon Fire TV. Your workout reacts to you.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/relay",
    "tools/build-graph",
    "tools/sim",
    "tools/fake-sensor",
    "tools/console-tv"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "tsc --build && node tools/build-graph/dist/cli.js",
    "sim": "tsc --build && node tools/sim/dist/cli.js",
    "relay": "tsc --build && node apps/relay/dist/main.js",
    "fake-sensor": "tsc --build && node tools/fake-sensor/dist/cli.js",
    "audit:copy": "bash scripts/audit-copy.sh",
    "verify": "npm run typecheck && npm run tv:typecheck && npm run lint && npm test && npm run tv:test && npm run audit:copy",
    "console-tv": "tsc --build && node tools/console-tv/dist/cli.js",
    "tv:typecheck": "tsc -p apps/tv --noEmit",
    "tv:test": "npm --prefix apps/tv test",
    "tv:build": "tsc --build && npm --prefix apps/tv run build:release"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
