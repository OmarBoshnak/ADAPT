{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "node"
    ],
    "paths": {
      "@adapt/core": [
        "./packages/core/src/index.ts"
      ],
      "@adapt/data": [
        "./packages/data/src/index.ts"
      ],
      "@adapt/data/fixtures": [
        "./packages/data/src/fixtures.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.fixture.ts",
    "apps/relay/src/**/*.test.ts",
    "tools/*/src/**/*.test.ts"
  ]
}
