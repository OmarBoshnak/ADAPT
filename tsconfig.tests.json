{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@adapt/core": ["./packages/core/src/index.ts"],
      "@adapt/data": ["./packages/data/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.test.ts", "packages/*/src/**/*.fixture.ts"]
}
