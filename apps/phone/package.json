  },
  "private": true,
  "description": "ADAPT phone companion — lies face-up on the floor, senses movement quality, and listens for correction words.",
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/src/$1",
      "^@adapt/core$": "<rootDir>/../../packages/core/dist/index.js"
